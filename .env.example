# AfterHours Environment Variables
# Copy this file to .env and fill in your keys.

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# API key for the AI Analyst (OpenAI-compatible). Leave empty to use mock AI.
# Groq is preferred for speed when GROQ_API_KEY is also set.
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Groq API key for fast market analysis inference. Leave empty to fall back to LLM_API_KEY.
# Get one at https://console.groq.com
GROQ_API_KEY=""

# ── Pyth Network ─────────────────────────────────────────────────────────────
# Pyth Pro / Hermes access token for live authenticated oracle feed updates.
# Acquire at https://docs.pyth.network/price-feeds/pro/acquire-access-token
# WITHOUT this key: gap data uses seeded reference prices (documented fallback)
# WITH this key: real-time Pyth price feeds for Equity.US.* -> Crypto.*X comparison
PYTH_HERMES_API_KEY=""

# ── Solana ───────────────────────────────────────────────────────────────────
# Network selection: mainnet-beta, devnet, testnet, localnet
# Default: devnet (demo mode — free, no real funds needed)
SOLANA_NETWORK="devnet"
# RPC endpoint override. Defaults to a public cluster RPC based on SOLANA_NETWORK.
SOLANA_RPC_URL=""
# Next.js requires NEXT_PUBLIC_ prefix for env vars used in the browser
NEXT_PUBLIC_SOLANA_NETWORK="mainnet-beta"
NEXT_PUBLIC_SOLANA_RPC=""
NEXT_PUBLIC_NETWORK_LABEL="Solana Mainnet-Beta"

# ── API / Web ────────────────────────────────────────────────────────────────
# Web frontend API URL (must be NEXT_PUBLIC_ prefixed for Next.js client-side)
NEXT_PUBLIC_API_URL="https://afterhour-i3xj.onrender.com/"
# API server port
API_PORT="8787"

# ── Release ──────────────────────────────────────────────────────────────────
AFTERHOURS_RELEASE_ID=""
