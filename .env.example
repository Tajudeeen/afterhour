# =============================================================================
# AfterHours — 24/7 intelligence for tokenized stocks on Solana
# =============================================================================
# Copy to .env and fill in. NEVER commit the real .env file.
# Required for API: DATABASE_URL, SOLANA_RPC_URL
# Required for AI: OPENAI_API_KEY (or leave empty for mock AI)
# Required for Next.js: NEXT_PUBLIC_API_URL
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/afterhours?schema=public"

# ── Solana ───────────────────────────────────────────────────────────────────
# Solana RPC endpoint. For production, use a paid RPC provider (Alchemy, QuickNode, Helius).
# For the hackathon demo, public RPC is sufficient.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Active network: mainnet-beta | devnet | testnet | localnet. Defaults to mainnet-beta,
# and is inferred from SOLANA_RPC_URL when unset. This is the single source of truth for
# both the wallet connection and every network label / Solscan link in the UI.
SOLANA_NETWORK="mainnet-beta"
# Same value, exposed to the browser (Next.js only inlines NEXT_PUBLIC_* into the client).
NEXT_PUBLIC_SOLANA_NETWORK="mainnet-beta"
# Optional: override the browser-side RPC endpoint.
NEXT_PUBLIC_SOLANA_RPC=""

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# OpenAI API key for the AI Analyst. Leave empty to use mock AI (deterministic demo).
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8787
NEXT_PUBLIC_API_URL="http://localhost:8787"
# Reviewed commit SHA or immutable image identity, exposed by the API /version route.
AFTERHOURS_RELEASE_ID=""

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
