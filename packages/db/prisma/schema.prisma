generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  wallet      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  policies    RiskPolicy[]
  decisions    AgentDecision[]
  transactions Transaction[]
}

model Wallet {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  address   String   @unique
  chain     String   @default("solana")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Asset {
  id               String    @id @default(uuid())
  symbol           String    @unique
  name             String
  mint             String    @unique
  decimals         Int       @default(6)
  referencePrice   Decimal  @db.Decimal(12, 4)
  referenceSource  String
  referenceUpdatedAt DateTime
  isSupported      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  prices           PriceSnapshot[]
  riskEvents       RiskEvent[]
}

model PriceSnapshot {
  id               String   @id @default(uuid())
  asset            Asset    @relation(fields: [assetId], references: [id])
  assetId          String
  onchainPrice     Decimal  @db.Decimal(12, 4)
  referencePrice   Decimal  @db.Decimal(12, 4)
  gapPercent       Decimal  @db.Decimal(8, 4)
  volume24h        Decimal  @db.Decimal(16, 2)
  liquidityUsd     Decimal  @db.Decimal(16, 2)
  liquidity        String
  marketStatus     String
  volatilityLevel  String
  observedAt       DateTime
  createdAt        DateTime @default(now())

  @@index([assetId, observedAt])
  @@index([observedAt])
}

model MarketState {
  id           String   @id @default(uuid())
  session      String   // "pre-market" | "open" | "post-market" | "closed"
  volatility   String   // "low" | "medium" | "high"
  liquidity    String   // "low" | "medium" | "high"
  isWeekend    Boolean  @default(false)
  regimeLabel  String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model PortfolioSnapshot {
  id            String    @id @default(uuid())
  wallet        String
  totalValueUsd Decimal   @db.Decimal(14, 2)
  holdings      Json
  createdAt     DateTime  @default(now())

  @@index([wallet, createdAt])
}

model RiskEvent {
  id            String   @id @default(uuid())
  asset         Asset    @relation(fields: [assetId], references: [id])
  assetId       String
  eventType     String   // "gap_detected" | "high_volatility" | "liquidity_drop" | "concentration"
  severity      String   // "info" | "warning" | "critical"
  gapPercent    Decimal? @db.Decimal(8, 4)
  metadata      Json?
  detectedAt    DateTime @default(now())
  resolvedAt    DateTime?

  @@index([assetId, detectedAt])
  @@index([eventType, severity])
}

model RiskPolicy {
  id                              String   @id @default(uuid())
  user            User?    @relation(fields: [userId], references: [id])
  userId          String?
  maxSingleAssetExposurePercent   Int      @default(35)
  maxTradeUsd                     Int      @default(1500)
  minUsdcReservePercent           Int      @default(10)
  maxDailyDrawdownPercent         Int      @default(3)
  requireUserApproval             Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model AgentDecision {
  id            String   @id @default(uuid())
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
  asset         String
  recommendation Json
  explanation   String
  confidence    Float
  riskScore     Int
  createdAt     DateTime @default(now())
}

model Transaction {
  id            String   @id @default(uuid())
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
  wallet        String
  action        String   // "buy" | "sell"
  asset         String
  amountUsd     Decimal  @db.Decimal(10, 2)
  signature     String
  status        String   // "pending" | "confirmed" | "failed"
  createdAt     DateTime @default(now())

  @@index([wallet, createdAt])
  @@index([signature])
}
