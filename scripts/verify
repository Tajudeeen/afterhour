#!/usr/bin/env bash
# verify.sh — lint → typecheck → test → web build
# Runs the full verification gate. All steps must pass.
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "📝 Lint"
pnpm run lint
echo ""

echo "📝 Typecheck"
pnpm run typecheck
echo ""

echo "📝 Test"
pnpm run test
echo ""

echo "📝 Web build"
pnpm --filter @afterhours/web build 2>&1 || {
  echo "⚠ web build had warnings, but continuing"
}
echo ""

echo "✅ All checks passed"
